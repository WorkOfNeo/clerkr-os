# Allowlist of emails that can sign up. Comma-separated, case-insensitive.
ALLOWED_EMAILS=yaw@clerkr.ai,patrick@clerkr.ai,niels@clerkr.ai

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL for Better Auth (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# Postgres connection URLs. REPLACE THE PLACEHOLDERS BELOW.
# - DATABASE_URL: used at runtime. On Railway use the internal URL (no sslmode).
# - DIRECT_URL: used by `prisma db push` and `prisma migrate deploy`. For
#   Railway, use the public proxy URL with ?sslmode=require
#   (wiki cmowr1gwc0000pr15wqflwj9s).
#
# Railway: in your service Variables tab set:
#   DATABASE_URL = ${{Postgres.DATABASE_PRIVATE_URL}}
#   DIRECT_URL   = ${{Postgres.DATABASE_PUBLIC_URL}}?sslmode=require
# Do NOT paste the literal placeholders below into Railway.
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB_NAME
DIRECT_URL=postgresql://USER:PASS@HOST:PORT/DB_NAME?sslmode=require

# OpenAI — gpt-4o-mini for chat, text-embedding-3-small for wiki embeddings.
# Optional in dev: the kanban + CRUD MCP tools still work without it; only the
# in-app LLM chat and semantic wiki search degrade (substring fallback).
OPENAI_API_KEY=

# ─── Documents (/documents) ───────────────────────────────────────────────
# Where uploaded files are kept. Leave DOCUMENTS_DIR UNSET and the bytes go in
# Postgres — nothing to provision, and the files are covered by the normal
# database backup. That is the default and it works out of the box.
#
# Once the files get big, move them to a Railway volume instead:
#   1. Railway → the service → Volumes → attach one, mount path /data
#   2. set DOCUMENTS_DIR=/data/documents
# Uploads then stream to disk and downloads stream back, so memory stays flat
# whatever the file size. Rows written before the switch keep serving from
# Postgres — `Document.storage` records where each one lives, so nothing has to
# be migrated and nothing breaks.
#
# NOTE: a Railway volume is attached to ONE service and is not shared between
# replicas. Fine for this single-instance internal tool; if the app is ever
# scaled horizontally, object storage is the next step.
DOCUMENTS_DIR=

# Per-file upload ceiling in MB. Default 50.
DOCUMENTS_MAX_MB=50

# ─── Push notifications (optional) ────────────────────────────────────────
# Without these the app runs fine and the in-app bell still works — it just
# never offers to push to a device. Generate a pair ONCE with:
#   npx web-push generate-vapid-keys
# Changing them later invalidates every existing subscription, so people have
# to turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services use if a send misbehaves.
VAPID_SUBJECT=mailto:nh@neo-labs.com
