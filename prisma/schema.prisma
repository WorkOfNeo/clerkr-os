// Pinned to Prisma v6 — v7 removed `url`/`directUrl` from schema.prisma
// (wiki cmowr3gzo0004pr15awevff3h).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── Better-Auth-managed models ─────────────────────────────────────────────
// Every id must have @default(uuid()) — Better-Auth's Prisma adapter omits
// `id` on create. The global `advanced.database.generateId: "uuid"` does NOT
// cover User (wiki cmp1usxah0004pf15nzrmtlnj). Set it on every model to be safe.

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String   @default("")
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions       Session[]
  accounts       Account[]
  apiTokens      ApiToken[]
  posts          Post[]
  wikiNotes      WikiNote[]
  chatSessions   ChatSession[]
  meetings       Meeting[]
  tickets        Ticket[]
  ticketComments TicketComment[]
  documents      Document[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── App-owned models ───────────────────────────────────────────────────────

model ApiToken {
  id          String    @id @default(uuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_token")
}

model Post {
  id          String    @id @default(uuid())
  url         String
  title       String
  description String?
  imageUrl    String?
  category    String?
  todo        String?
  painPoint   String?
  priority    Int       @default(3)
  postedAt    DateTime?
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([createdAt])
  @@index([priority])
  @@index([authorId])
  @@map("post")
}

// Taxonomy — editable lists. New rows added via the settings UI or MCP.

// ─── Wiki ──────────────────────────────────────────────────────────────────
// Embeddings stored as pgvector(1536) — text-embedding-3-small dimensions.
// The HNSW index is added via raw SQL in the migration (Prisma can't model
// index opclasses on Unsupported columns).

model WikiNote {
  id         String                       @id @default(uuid())
  slug       String                       @unique
  title      String
  body       String // markdown
  tags       String[]                     @default([])
  embedding  Unsupported("vector(1536)")?
  embeddedAt DateTime?
  authorId   String
  author     User                         @relation(fields: [authorId], references: [id])
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @default(now()) @updatedAt

  attachments Attachment[]

  @@index([authorId])
  @@map("wiki_note")
}

// ─── Chat ──────────────────────────────────────────────────────────────────

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatSession {
  id        String   @id @default(uuid())
  title     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_session")
}

model ChatMessage {
  id           String      @id @default(uuid())
  sessionId    String
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         ChatRole
  content      String
  citedNoteIds String[]    @default([])
  createdAt    DateTime    @default(now())

  attachments Attachment[]
  proposals   IntakeProposal[]

  @@index([sessionId, createdAt])
  @@map("chat_message")
}

// ─── Chat intake ─────────────────────────────────────────────────────────────
// The chat is the front door: you paste raw notes and the model works out what
// they ARE — a meeting to structure, three bugs, a wiki note, a card for the
// board — and proposes each one as a card you confirm before anything is
// written. Nothing is created behind your back; a proposal is a draft until
// somebody accepts it.
//
// Proposals are rows rather than JSON on the message because they have a
// lifecycle: they get accepted one at a time, edited before accepting, or
// dismissed, and after a reload the chat has to show which is which.

enum IntakeKind {
  TICKET
  MEETING
  WIKI_NOTE
  KANBAN_CARD
  FEATURE
  // Not a new record — a comment on something that already exists, which is
  // what a near-duplicate should become.
  COMMENT
}

enum IntakeStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
}

model IntakeProposal {
  id        String      @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  kind   IntakeKind
  status IntakeStatus @default(PROPOSED)
  order  Int          @default(0) // order the cards were proposed in

  title String
  body  String?

  // Kind-specific extras the classifier filled in — ticket category, meeting
  // attendees, kanban column, tags, due date. Shape varies by `kind`, which is
  // exactly why it is Json and not columns.
  payload Json @default("{}")

  // The "check it against what we already have" half. A high score means this
  // is probably not new, and the UI offers commenting on `matchId` instead of
  // filing a duplicate.
  matchType  String? // "ticket" | "feature" | "meeting" | "wiki_note" | "kanban_card"
  matchId    String?
  matchTitle String?
  matchScore Float? // cosine similarity, 0-1

  // Filled in once accepted, so the card can link to what it became.
  createdType String?
  createdId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([messageId, order])
  @@index([status])
  @@map("intake_proposal")
}

// ─── Meetings → Briefs ───────────────────────────────────────────────────────
// A Meeting holds the raw transcript/summary. `extractBrief` (src/lib/ai) turns
// it into a structured brief: the TL;DR lives on the Meeting; decisions,
// feature signals, action items and open questions are normalised child rows so
// they can later link into the Feature Library / Knowledge graph. Re-running the
// extraction clears and re-creates the children (our own data — safe to delete).

enum MeetingKind {
  INTERNAL
  CUSTOMER
  PROSPECT
}

enum SignalStatus {
  NEW // a feature idea not obviously already built/planned
  ALREADY_TRACKED // sounds like an existing/known capability
  SMALL_UNIQUE // niche, narrow one-off worth keeping
}

model Meeting {
  id           String                       @id @default(uuid())
  slug         String                       @unique
  title        String
  kind         MeetingKind                  @default(INTERNAL)
  meetingDate  DateTime
  attendees    String[]                     @default([])
  transcript   String // raw pasted transcript / summary
  tldr         String? // AI-generated brief summary
  structuredAt DateTime? // set when the brief was last extracted
  embedding    Unsupported("vector(1536)")? // semantic-search vector (raw SQL writes)
  embeddedAt   DateTime?
  authorId     String
  author       User                         @relation(fields: [authorId], references: [id])
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @default(now()) @updatedAt

  attachments    Attachment[]
  decisions      Decision[]
  featureSignals FeatureSignal[]
  actionItems    ActionItem[]
  openQuestions  OpenQuestion[]

  @@index([meetingDate])
  @@index([authorId])
  @@map("meeting")
}

model Decision {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  owner     String?
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@map("decision")
}

model FeatureSignal {
  id        String       @id @default(uuid())
  meetingId String
  meeting   Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String
  detail    String?
  status    SignalStatus @default(NEW)
  tags      String[]     @default([])
  // Set when this signal is promoted into / linked to a Feature Library entry.
  featureId String?
  feature   Feature?     @relation(fields: [featureId], references: [id])
  createdAt DateTime     @default(now())

  @@index([meetingId])
  @@index([status])
  @@index([featureId])
  @@map("feature_signal")
}

model ActionItem {
  id        String    @id @default(uuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  assignee  String?
  dueDate   DateTime?
  done      Boolean   @default(false)
  // Set when this action item has been raised as a ticket (1:1).
  ticketId  String?   @unique
  ticket    Ticket?   @relation(fields: [ticketId], references: [id])
  createdAt DateTime  @default(now())

  @@index([meetingId])
  @@map("action_item")
}

model OpenQuestion {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@map("open_question")
}

// ─── Feature Library + Knowledge ─────────────────────────────────────────────
// Features are the self-growing catalog. They group into Clusters (the "living
// wiki" hubs) and can cross-link via FeatureLink (the knowledge-graph edges).
// Meeting FeatureSignals promote into Features; KanbanCards point at Features.

enum FeatureStatus {
  IDEA
  VALIDATED
  IN_ROADMAP
  SHIPPED
  SMALL_UNIQUE
}

enum FeatureLinkKind {
  RELATED
  DEPENDS_ON
}

model Cluster {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  icon          String? // emoji/glyph shown on the hub node
  color         String? // accent token name or hex
  autoSuggested Boolean  @default(false) // emerged from Copilot pattern detection
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  features Feature[]

  @@map("cluster")
}

model Feature {
  id          String                       @id @default(uuid())
  slug        String                       @unique
  title       String
  description String?
  status      FeatureStatus                @default(IDEA)
  tags        String[]                     @default([])
  clusterId   String?
  cluster     Cluster?                     @relation(fields: [clusterId], references: [id])
  embedding   Unsupported("vector(1536)")? // semantic-search + dedupe vector (raw SQL writes)
  embeddedAt  DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @default(now()) @updatedAt

  signals     FeatureSignal[] // meeting signals promoted/linked to this feature
  kanbanCards KanbanCard[]
  attachments Attachment[]
  linksFrom   FeatureLink[]   @relation("FeatureLinkFrom")
  linksTo     FeatureLink[]   @relation("FeatureLinkTo")

  @@index([clusterId])
  @@index([status])
  @@map("feature")
}

model FeatureLink {
  id        String          @id @default(uuid())
  fromId    String
  toId      String
  kind      FeatureLinkKind @default(RELATED)
  from      Feature         @relation("FeatureLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Feature         @relation("FeatureLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([fromId, toId])
  @@index([toId])
  @@map("feature_link")
}

// ─── App settings ────────────────────────────────────────────────────────────
// Key/value store for editable config the AI reads before firing — e.g. the
// meeting-extraction system prompt and the Copilot system prompt. Falls back to
// code defaults (src/lib/ai/prompts.ts) when a key is absent.

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_setting")
}

// ─── Kanban ──────────────────────────────────────────────────────────────────
// Replaces the fixed Now / Next / Later roadmap. The board's columns are
// EDITABLE ROWS (KanbanColumn), not an enum, so the team can invent whatever
// workflow they actually run — "Blocked on legal", "Waiting on client" — from
// the UI with no deploy. Same call as TicketCategory.
//
// The one piece of meaning the code needs is "does landing here mean it's
// done", and that is what `isDone` carries: a card entering an isDone column
// gets `completedAt` stamped, and cleared again on the way out. So "done" is a
// property the user assigns to a column of their choosing rather than a status
// the code owns.
//
// Contrast with TicketStatus, which stays an enum on purpose — ticket code
// branches on resolved-ness and must not have that changed underneath it. Here
// the board IS the workflow, so the workflow has to be editable.

// A board is a whole workflow: its own columns, its own cards. Multiple boards
// exist because one team runs several unrelated processes — a product board and
// a hiring board share nothing but the mechanics.
model KanbanBoard {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?

  sortOrder Int     @default(0) // order of the pills under the page title
  isDefault Boolean @default(false) // the one /kanban opens on

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  columns KanbanColumn[]

  @@map("kanban_board")
}

model KanbanColumn {
  id String @id @default(uuid())

  // Cascade: deleting a board takes its columns with it. The cards' own
  // Restrict FK then blocks that whole cascade while any card still exists, so
  // a board holding work cannot be deleted by accident — the database enforces
  // it, and deleteBoard() checks first so the user gets a sentence rather than
  // a foreign-key error.
  boardId String
  board   KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  slug        String
  name        String
  description String?
  color       String // hex, drives the header dot and the card accent
  icon        String? // lucide icon name rendered in the column header

  sortOrder Int @default(0) // sparse (10, 20, 30…) so a column can slot between two others

  // Landing here means the work is finished. Any number of columns may be
  // terminal — "Shipped" and "Won't do" both are.
  isDone Boolean @default(false)

  // Where a card lands when no column is named (MCP calls, chat intake, quick
  // add). Exactly one column holds this; `setDefaultColumn` enforces it.
  isDefault Boolean @default(false)

  // Soft ceiling — the header flags amber past it. Null means no limit.
  wipLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  cards KanbanCard[]

  @@unique([boardId, slug])
  @@unique([boardId, name])
  @@index([boardId, sortOrder])
  @@map("kanban_column")
}

model KanbanCard {
  id     String @id @default(uuid())
  slug   String @unique
  number Int    @unique @default(autoincrement()) // human handle: #14

  title       String
  description String?

  // Required — a card with no column has nowhere to render. Hence
  // `onDelete: Restrict` rather than SetNull: deleting a column that still
  // holds cards is refused and the UI makes you say where they should go
  // instead. Deleting a column must never delete the work in it.
  columnId String
  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Restrict)

  order Int @default(0) // sparse ordering within a column, for drag autosave

  confidence  Int       @default(0) // 0-5, shown as the confidence meter
  themeTag    String?
  blocked     Boolean   @default(false)
  blockerNote String?
  dueDate     DateTime?

  // Stamped when the card enters an isDone column, cleared when it leaves.
  completedAt DateTime?

  featureId String?
  feature   Feature? @relation(fields: [featureId], references: [id])

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([columnId, order])
  @@index([featureId])
  @@map("kanban_card")
}

// ─── Tickets ─────────────────────────────────────────────────────────────────
// Replaces the Google Doc: anything raised — an idea, a bug, a feature request,
// an open question — becomes a Ticket. Neo (or a teammate, or Claude via MCP)
// files it; the developer comments on it and marks it fixed/shipped.
//
// The TYPE is an editable row (TicketCategory), not an enum, so a new category
// can be added from /settings/categories without a deploy. The STATUS is an
// enum on purpose — code branches on "is this resolved", and that shouldn't be
// editable out from under the logic.

enum TicketStatus {
  OPEN // raised, nobody's on it
  IN_PROGRESS // being worked on
  FIXED // done in code, not yet released
  SHIPPED // out and live
  WONT_FIX // deliberately closed without doing it
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  MANUAL // filed in the web UI
  MCP // filed by Claude through the MCP server
  MEETING // pushed over from a meeting action item
}

// Editable taxonomy — seeded with Idea / Bug / Feature request / Question, then
// maintained from the app. Slug is the stable key so re-seeding is idempotent
// even after a label is renamed.
model TicketCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String   @unique
  color     String // hex, drives the badge
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tickets Ticket[]

  @@map("ticket_category")
}

model Ticket {
  id     String  @id @default(uuid())
  slug   String  @unique
  number Int     @unique @default(autoincrement()) // human handle: #14
  title  String
  body   String? // markdown

  // Nullable so deleting a category never deletes the tickets filed under it.
  categoryId String?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  // Who put it in the system (always a real user — Claude files under the owner
  // of its API token) vs. who it actually came from, which may be someone with
  // no account here at all: a teammate, or a lawyer at a customer firm.
  authorId   String
  author     User    @relation(fields: [authorId], references: [id])
  reportedBy String?

  source TicketSource @default(MANUAL)

  embedding  Unsupported("vector(1536)")? // semantic search + duplicate detection
  embeddedAt DateTime?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  comments     TicketComment[]
  attachments  Attachment[]
  chatSessions ChatSession[]
  actionItem   ActionItem?

  @@index([status, updatedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("ticket")
}

model TicketComment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  body     String
  authorId String
  author   User         @relation(fields: [authorId], references: [id])
  source   TicketSource @default(MANUAL)

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_comment")
}

// Screenshot bytes live in Postgres, same pattern as prod-spec's rejection
// attachments (wiki cmquudjcd001ypf159yd5frw8) — no S3, no new dependency.
// Images are downscaled client-side before upload so rows stay small, and are
// served back behind auth from /api/attachments/[id].
//
// ONE attachment table for the whole app, not one per feature: a screenshot is
// a screenshot whether it is pinned to a ticket, a kanban card, a meeting or a
// chat message. Parents are separate nullable FKs rather than an
// (entityType, entityId) pair, so the database still enforces that an
// attachment points at something real and still cascades when that parent goes
// — a polymorphic string pair gives up both.
//
// Exactly one parent should be set. `attachmentOwner()` in
// src/lib/attachments.ts is the only thing that builds these, which is what
// keeps that true.
model Attachment {
  id String @id @default(uuid())

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  commentId String?
  comment   TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  kanbanCardId String?
  kanbanCard   KanbanCard? @relation(fields: [kanbanCardId], references: [id], onDelete: Cascade)

  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  wikiNoteId String?
  wikiNote   WikiNote? @relation(fields: [wikiNoteId], references: [id], onDelete: Cascade)

  featureId String?
  feature   Feature? @relation(fields: [featureId], references: [id], onDelete: Cascade)

  chatMessageId String?
  chatMessage   ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  data     Bytes
  mimeType String
  fileName String
  byteSize Int
  width    Int?
  height   Int?

  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([commentId])
  @@index([kanbanCardId])
  @@index([meetingId])
  @@index([wikiNoteId])
  @@index([featureId])
  @@index([chatMessageId])
  @@map("attachment")
}

// ─── Documents ───────────────────────────────────────────────────────────────
// A general file store: PDFs, images, spreadsheets, decks — anything. Distinct
// from an Attachment, which is specifically a screenshot pinned to something and
// one ticket and is downscaled to stay tiny. A Document is the original file,
// byte for byte, kept because someone will need it again.
//
// WHERE THE BYTES LIVE is a per-row fact, not a global one, so the backend can
// change without a migration and old rows keep resolving:
//   POSTGRES — `data` holds the bytes. The default: zero infrastructure, and
//              the files ride along in the normal database backup.
//   VOLUME   — `storageKey` is a path inside DOCUMENTS_DIR (a Railway volume).
//              Streams instead of buffering, so it is the one to use once the
//              files get big.
// See src/lib/documents/storage.ts.

enum DocumentStorage {
  POSTGRES
  VOLUME
}

// Editable taxonomy, exactly like TicketCategory: a folder is a row, so one can
// be added or renamed without a deploy. `Document.folderId` is nullable with
// onDelete: SetNull — deleting a folder must never delete the files in it.
model DocumentFolder {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String   @unique
  description String?
  color       String? // hex, drives the badge
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  documents Document[]

  @@map("document_folder")
}

model Document {
  id String @id @default(uuid())

  // `title` is the editable display name; `fileName` is what was uploaded and
  // what a download is named. Renaming a document must not break its extension.
  title       String
  description String?
  fileName    String
  mimeType    String
  byteSize    Int
  checksum    String // sha256 hex, computed while streaming the upload
  tags        String[] @default([])

  folderId String?
  folder   DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  storage    DocumentStorage
  storageKey String? // path within DOCUMENTS_DIR when storage = VOLUME
  data       Bytes? // the bytes themselves when storage = POSTGRES

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([folderId])
  @@index([createdAt])
  @@index([checksum])
  @@index([uploadedById])
  @@map("document")
}
