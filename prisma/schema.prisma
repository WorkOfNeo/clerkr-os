// Pinned to Prisma v6 — v7 removed `url`/`directUrl` from schema.prisma
// (wiki cmowr3gzo0004pr15awevff3h).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── Better-Auth-managed models ─────────────────────────────────────────────
// Every id must have @default(uuid()) — Better-Auth's Prisma adapter omits
// `id` on create. The global `advanced.database.generateId: "uuid"` does NOT
// cover User (wiki cmp1usxah0004pf15nzrmtlnj). Set it on every model to be safe.

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String   @default("")
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions       Session[]
  accounts       Account[]
  apiTokens      ApiToken[]
  posts          Post[]
  wikiNotes      WikiNote[]
  chatSessions   ChatSession[]
  meetings       Meeting[]
  tickets        Ticket[]
  ticketComments TicketComment[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── App-owned models ───────────────────────────────────────────────────────

model ApiToken {
  id          String    @id @default(uuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String    @unique
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_token")
}

model Post {
  id          String    @id @default(uuid())
  url         String
  title       String
  description String?
  imageUrl    String?
  category    String?
  todo        String?
  painPoint   String?
  priority    Int       @default(3)
  postedAt    DateTime?
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([createdAt])
  @@index([priority])
  @@index([authorId])
  @@map("post")
}

// Taxonomy — editable lists. New rows added via the settings UI or MCP.

// ─── Wiki ──────────────────────────────────────────────────────────────────
// Embeddings stored as pgvector(1536) — text-embedding-3-small dimensions.
// The HNSW index is added via raw SQL in the migration (Prisma can't model
// index opclasses on Unsupported columns).

model WikiNote {
  id         String                       @id @default(uuid())
  slug       String                       @unique
  title      String
  body       String // markdown
  tags       String[]                     @default([])
  embedding  Unsupported("vector(1536)")?
  embeddedAt DateTime?
  authorId   String
  author     User                         @relation(fields: [authorId], references: [id])
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @default(now()) @updatedAt

  @@index([authorId])
  @@map("wiki_note")
}

// ─── Chat ──────────────────────────────────────────────────────────────────

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatSession {
  id        String   @id @default(uuid())
  title     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  messages ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_session")
}

model ChatMessage {
  id           String      @id @default(uuid())
  sessionId    String
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         ChatRole
  content      String
  citedNoteIds String[]    @default([])
  createdAt    DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_message")
}

// ─── Meetings → Briefs ───────────────────────────────────────────────────────
// A Meeting holds the raw transcript/summary. `extractBrief` (src/lib/ai) turns
// it into a structured brief: the TL;DR lives on the Meeting; decisions,
// feature signals, action items and open questions are normalised child rows so
// they can later link into the Feature Library / Knowledge graph. Re-running the
// extraction clears and re-creates the children (our own data — safe to delete).

enum MeetingKind {
  INTERNAL
  CUSTOMER
  PROSPECT
}

enum SignalStatus {
  NEW // a feature idea not obviously already built/planned
  ALREADY_TRACKED // sounds like an existing/known capability
  SMALL_UNIQUE // niche, narrow one-off worth keeping
}

model Meeting {
  id           String                       @id @default(uuid())
  slug         String                       @unique
  title        String
  kind         MeetingKind                  @default(INTERNAL)
  meetingDate  DateTime
  attendees    String[]                     @default([])
  transcript   String // raw pasted transcript / summary
  tldr         String? // AI-generated brief summary
  structuredAt DateTime? // set when the brief was last extracted
  embedding    Unsupported("vector(1536)")? // semantic-search vector (raw SQL writes)
  embeddedAt   DateTime?
  authorId     String
  author       User                         @relation(fields: [authorId], references: [id])
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @default(now()) @updatedAt

  decisions      Decision[]
  featureSignals FeatureSignal[]
  actionItems    ActionItem[]
  openQuestions  OpenQuestion[]

  @@index([meetingDate])
  @@index([authorId])
  @@map("meeting")
}

model Decision {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  owner     String?
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@map("decision")
}

model FeatureSignal {
  id        String       @id @default(uuid())
  meetingId String
  meeting   Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String
  detail    String?
  status    SignalStatus @default(NEW)
  tags      String[]     @default([])
  // Set when this signal is promoted into / linked to a Feature Library entry.
  featureId String?
  feature   Feature?     @relation(fields: [featureId], references: [id])
  createdAt DateTime     @default(now())

  @@index([meetingId])
  @@index([status])
  @@index([featureId])
  @@map("feature_signal")
}

model ActionItem {
  id        String    @id @default(uuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  assignee  String?
  dueDate   DateTime?
  done      Boolean   @default(false)
  // Set when this action item has been raised as a ticket (1:1).
  ticketId  String?   @unique
  ticket    Ticket?   @relation(fields: [ticketId], references: [id])
  createdAt DateTime  @default(now())

  @@index([meetingId])
  @@map("action_item")
}

model OpenQuestion {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@map("open_question")
}

// ─── Feature Library + Knowledge ─────────────────────────────────────────────
// Features are the self-growing catalog. They group into Clusters (the "living
// wiki" hubs) and can cross-link via FeatureLink (the knowledge-graph edges).
// Meeting FeatureSignals promote into Features; RoadmapItems point at Features.

enum FeatureStatus {
  IDEA
  VALIDATED
  IN_ROADMAP
  SHIPPED
  SMALL_UNIQUE
}

enum FeatureLinkKind {
  RELATED
  DEPENDS_ON
}

model Cluster {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  description   String?
  icon          String? // emoji/glyph shown on the hub node
  color         String? // accent token name or hex
  autoSuggested Boolean  @default(false) // emerged from Copilot pattern detection
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  features Feature[]

  @@map("cluster")
}

model Feature {
  id          String                       @id @default(uuid())
  slug        String                       @unique
  title       String
  description String?
  status      FeatureStatus                @default(IDEA)
  tags        String[]                     @default([])
  clusterId   String?
  cluster     Cluster?                     @relation(fields: [clusterId], references: [id])
  embedding   Unsupported("vector(1536)")? // semantic-search + dedupe vector (raw SQL writes)
  embeddedAt  DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @default(now()) @updatedAt

  signals      FeatureSignal[] // meeting signals promoted/linked to this feature
  roadmapItems RoadmapItem[]
  linksFrom    FeatureLink[]   @relation("FeatureLinkFrom")
  linksTo      FeatureLink[]   @relation("FeatureLinkTo")

  @@index([clusterId])
  @@index([status])
  @@map("feature")
}

model FeatureLink {
  id        String          @id @default(uuid())
  fromId    String
  toId      String
  kind      FeatureLinkKind @default(RELATED)
  from      Feature         @relation("FeatureLinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Feature         @relation("FeatureLinkTo", fields: [toId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([fromId, toId])
  @@index([toId])
  @@map("feature_link")
}

// ─── Roadmap ─────────────────────────────────────────────────────────────────
// Now / Next / Later lanes with sparse `order` for drag autosave (mirror the
// kanban ordering pattern). Items optionally point at a Feature.

enum RoadmapLane {
  NOW
  NEXT
  LATER
}

// ─── App settings ────────────────────────────────────────────────────────────
// Key/value store for editable config the AI reads before firing — e.g. the
// meeting-extraction system prompt and the Copilot system prompt. Falls back to
// code defaults (src/lib/ai/prompts.ts) when a key is absent.

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_setting")
}

model RoadmapItem {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  description String?
  lane        RoadmapLane @default(LATER)
  order       Int         @default(0) // sparse ordering within a lane
  confidence  Int         @default(0) // 0-5, shown as the confidence meter
  themeTag    String?
  blocked     Boolean     @default(false)
  blockerNote String?
  featureId   String?
  feature     Feature?    @relation(fields: [featureId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@index([lane, order])
  @@map("roadmap_item")
}

// ─── Tickets ─────────────────────────────────────────────────────────────────
// Replaces the Google Doc: anything raised — an idea, a bug, a feature request,
// an open question — becomes a Ticket. Neo (or a teammate, or Claude via MCP)
// files it; the developer comments on it and marks it fixed/shipped.
//
// The TYPE is an editable row (TicketCategory), not an enum, so a new category
// can be added from /settings/categories without a deploy. The STATUS is an
// enum on purpose — code branches on "is this resolved", and that shouldn't be
// editable out from under the logic.

enum TicketStatus {
  OPEN // raised, nobody's on it
  IN_PROGRESS // being worked on
  FIXED // done in code, not yet released
  SHIPPED // out and live
  WONT_FIX // deliberately closed without doing it
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  MANUAL // filed in the web UI
  MCP // filed by Claude through the MCP server
  MEETING // pushed over from a meeting action item
}

// Editable taxonomy — seeded with Idea / Bug / Feature request / Question, then
// maintained from the app. Slug is the stable key so re-seeding is idempotent
// even after a label is renamed.
model TicketCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String   @unique
  color     String // hex, drives the badge
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tickets Ticket[]

  @@map("ticket_category")
}

model Ticket {
  id     String  @id @default(uuid())
  slug   String  @unique
  number Int     @unique @default(autoincrement()) // human handle: #14
  title  String
  body   String? // markdown

  // Nullable so deleting a category never deletes the tickets filed under it.
  categoryId String?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  // Who put it in the system (always a real user — Claude files under the owner
  // of its API token) vs. who it actually came from, which may be someone with
  // no account here at all: a teammate, or a lawyer at a customer firm.
  authorId   String
  author     User    @relation(fields: [authorId], references: [id])
  reportedBy String?

  source TicketSource @default(MANUAL)

  embedding  Unsupported("vector(1536)")? // semantic search + duplicate detection
  embeddedAt DateTime?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  comments     TicketComment[]
  attachments  TicketAttachment[]
  chatSessions ChatSession[]
  actionItem   ActionItem?

  @@index([status, updatedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("ticket")
}

model TicketComment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  body     String
  authorId String
  author   User         @relation(fields: [authorId], references: [id])
  source   TicketSource @default(MANUAL)

  attachments TicketAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_comment")
}

// Screenshot bytes live in Postgres, same pattern as prod-spec's rejection
// attachments (wiki cmquudjcd001ypf159yd5frw8) — no S3, no new dependency.
// Images are downscaled client-side before upload so rows stay small, and are
// served back behind auth from /api/attachments/[id].
model TicketAttachment {
  id String @id @default(uuid())

  // Attached either to the ticket itself or to one of its comments.
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  commentId String?
  comment   TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  data     Bytes
  mimeType String
  fileName String
  byteSize Int
  width    Int?
  height   Int?

  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([commentId])
  @@map("ticket_attachment")
}
